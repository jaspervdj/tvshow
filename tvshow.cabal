Name:          tvshow
Version:       0.1.0.0
Synopsis:      Show photos on my TV
Description:   Show photos on my TV
License:       GPL-2
License-file:  LICENSE
Author:        Jasper Van der Jeugt <m@jaspervdj.be>
Maintainer:    Jasper Van der Jeugt <m@jaspervdj.be>
Homepage:      http://github.com/jaspervdj/tvshow
Copyright:     2026 Jasper Van der Jeugt
Category:      Media
Build-type:    Simple
Cabal-version: >=1.10

Executable tvshow
  Main-is:          Main.hs
  Ghc-options:      -Wall -threaded -rtsopts "-with-rtsopts=-N"
  Default-language: Haskell2010
  Build-depends:
    base       >= 4    && < 5,
    base64     >= 0.4  && < 1.1,
    blaze-html >= 0.9  && < 0.10,
    bytestring >= 0.12 && < 0.13,
    directory  >= 1.3  && < 1.4,
    filepath   >= 1.4  && < 1.6,
    http-types >= 0.12 && < 0.13,
    network    >= 3.2  && < 3.3,
    process    >= 1.6  && < 1.7,
    text       >= 2.1  && < 2.2,
    vector     >= 0.13 && < 0.14,
    wai        >= 3.2  && < 3.3,
    warp       >= 3.4  && < 3.5
